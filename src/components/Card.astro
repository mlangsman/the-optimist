---
/**
 * A front-page / related-rail card.
 *
 * Structure follows the Guardian's own card: a positioned `<article>` root with
 * a single empty, absolutely-positioned `<a>` overlaying it that carries the
 * href and an aria-label of the full headline, so the whole card is one click
 * target and the headline text is not itself a link.
 *
 * `card.linked === false` renders exactly the same markup minus that anchor —
 * a plain, non-interactive `<article>`.
 *
 * Variants map onto the Guardian's card sizes inside a flexible/general container:
 *   splash     the first story: headline column left, big picture right
 *   wide       a full-width row: text left, picture right, smaller than splash
 *   medium     half-width row: picture left, text right
 *   small      quarter-width: picture on top (secondary containers, related rail)
 *   highlight  the masthead strip: text left, square thumbnail right
 */
import type { Card } from '../lib/types';
import type { Pillar } from '../lib/data';
import { pillarForCard } from '../lib/data';
import { articleHref } from '../lib/url';

type Variant = 'splash' | 'wide' | 'medium' | 'small' | 'highlight';

interface Props {
	card: Card;
	variant?: Variant;
	/** Pillar inherited from the container; a card's kicker can override it. */
	pillar?: Pillar;
	/** Heading level so each container keeps a sane outline. */
	as?: 'h2' | 'h3' | 'h4';
	/** Load the image eagerly (the splash only). */
	eager?: boolean;
}

const { card, variant = 'medium', pillar = 'news', as: Heading = 'h3', eager = false } = Astro.props;

const cardPillar = pillarForCard(card, pillar);
const href = card.linked ? articleHref(card.path) : undefined;
const showImage = Boolean(card.image);
// As on the Guardian's front, only the splash and full-width cards carry a
// trail, and news cards carry no byline at all.
const showTrail = Boolean(card.trail) && (variant === 'splash' || variant === 'wide');
// The "What's being done" line is The Optimist's own addition: it runs on
// every card big enough to hold it.
const showProgress = Boolean(card.progress) && variant !== 'small' && variant !== 'highlight';
---

<article class:list={['card', `card--${variant}`]} data-pillar={cardPillar} data-linked={String(card.linked)}>
	{
		href && (
			<a class="card__link" href={href} aria-label={card.headline}>
				<span class="visually-hidden">{card.headline}</span>
			</a>
		)
	}

	<div class="card__inner">
		{
			showImage && card.image && (
				<div class="card__media">
					<img
						src={card.image.src}
						alt={card.image.alt ?? ''}
						width={card.image.width ?? 620}
						height={card.image.height ?? 372}
						loading={eager ? 'eager' : 'lazy'}
						decoding="async"
					/>
				</div>
			)
		}

		<div class="card__text">
			<Heading class="card__headline">
				{card.kicker && <span class="card__kicker">{card.kicker}</span>}
				<span class="card__headline-text">{card.headline}</span>
			</Heading>

			{showTrail && <p class="card__trail">{card.trail}</p>}

			{
				showProgress && (
					<p class="card__progress">
						<span class="card__progress-label">What’s being done</span> {card.progress}
					</p>
				)
			}
		</div>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		width: 100%;
		background: var(--card-background);
	}

	.card__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		width: 100%;
		min-width: 0;
	}

	/* Whole-card click target. Sits above the content but below nothing else,
	   so the card has exactly one focusable element. */
	.card__link {
		position: absolute;
		inset: 0;
		z-index: 2;
	}

	.card[data-linked='true']:hover .card__headline-text,
	.card:focus-within .card__headline-text {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	/* --- media ---------------------------------------------------------- */
	.card__media {
		background: var(--card-media-background);
		aspect-ratio: 5 / 3;
		overflow: hidden;
		flex: 0 0 auto;
	}

	.card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* --- text ----------------------------------------------------------- */
	.card__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		min-width: 0;
	}

	.card__headline {
		font-family: var(--font-headline);
		font-optical-sizing: auto;
		font-weight: 500;
		line-height: var(--leading-headline);
		color: var(--card-headline-text);
		font-size: var(--size-headline-17);
		display: flex;
		flex-direction: column;
		gap: var(--space-0);
	}

	/* Guardian card kickers are regular-weight sans, 15px rising to 17px. */
	.card__kicker {
		font-family: var(--font-sans);
		font-size: var(--size-sans-15);
		font-weight: 400;
		line-height: 1.15;
		/* Read --pillar directly, not a token that aliases it: an alias
		   declared on :root resolves against :root's --pillar and inherits
		   that literal colour, ignoring the card's own data-pillar. */
		color: var(--pillar);
	}

	.card__trail {
		font-family: var(--font-sans);
		font-size: var(--size-sans-14);
		line-height: var(--leading-sans);
		color: var(--card-trail-text);
	}

	.card__progress {
		font-family: var(--font-sans);
		font-size: var(--size-sans-14);
		line-height: var(--leading-sans);
		color: var(--neutral-20);
		border-left: 3px solid var(--brand-400);
		padding-left: var(--space-2);
	}

	.card__progress-label {
		display: block;
		font-weight: 700;
		color: var(--brand-400);
	}

	@media (min-width: 980px) {
		.card__kicker {
			font-size: var(--size-sans-17);
		}
	}

	/* --- splash --------------------------------------------------------- */
	/* headlineMedium28 → 34: the Guardian's splash is medium weight, not bold. */
	.card--splash .card__headline {
		font-size: var(--size-headline-28);
	}

	.card--splash .card__trail {
		font-size: var(--size-sans-15);
	}

	@media (min-width: 740px) {
		/* row-reverse puts the text on the left and the picture on the right,
		   matching the Guardian's splash card. */
		.card--splash .card__inner {
			flex-direction: row-reverse;
			align-items: flex-start;
			gap: var(--space-5);
		}
		.card--splash .card__media {
			flex: 1 1 62%;
			min-width: 0;
		}
		.card--splash .card__text {
			flex: 1 1 38%;
			min-width: 0;
		}
		.card--splash .card__headline {
			font-size: var(--size-headline-34);
		}
		.card--splash .card__trail {
			font-size: var(--size-sans-17);
		}
	}

	@media (min-width: 980px) {
		.card--splash .card__media {
			flex-basis: 66%;
		}
		.card--splash .card__text {
			flex-basis: 34%;
		}
	}

	/* --- wide ----------------------------------------------------------- */
	.card--wide .card__headline {
		font-size: var(--size-headline-24);
	}

	@media (min-width: 740px) {
		.card--wide .card__inner {
			flex-direction: row-reverse;
			align-items: flex-start;
			gap: var(--space-5);
		}
		.card--wide .card__media {
			flex: 1 1 50%;
			min-width: 0;
		}
		.card--wide .card__text {
			flex: 1 1 50%;
			min-width: 0;
		}
		.card--wide .card__headline {
			font-size: var(--size-headline-24);
		}
		.card--wide .card__trail {
			font-size: var(--size-sans-15);
		}
	}

	@media (min-width: 980px) {
		.card--wide .card__headline {
			font-size: var(--size-headline-28);
		}
	}

	/* --- medium --------------------------------------------------------- */
	.card--medium .card__inner {
		flex-direction: row;
		align-items: flex-start;
		gap: var(--space-3);
	}

	.card--medium .card__media {
		flex: 0 0 36%;
		min-width: 0;
	}

	.card--medium .card__text {
		flex: 1 1 auto;
	}

	.card--medium .card__headline {
		font-size: var(--size-headline-17);
	}

	@media (min-width: 740px) {
		.card--medium .card__inner {
			gap: var(--space-4);
		}
		.card--medium .card__media {
			flex-basis: 48%;
		}
		.card--medium .card__headline {
			font-size: var(--size-headline-20);
		}
	}

	/* --- small (secondary containers, related rail) ---------------------- */
	.card--small .card__headline {
		font-size: var(--size-headline-17);
	}

	/* --- highlight (masthead strip) ------------------------------------- */
	.card--highlight {
		background: var(--highlights-card-background);
		padding: var(--space-3);
		height: 100%;
	}

	.card--highlight .card__inner {
		flex-direction: row-reverse;
		align-items: flex-start;
		gap: var(--space-3);
	}

	/* The Guardian crops highlight thumbnails to a circle. */
	.card--highlight .card__media {
		flex: 0 0 auto;
		width: 80px;
		aspect-ratio: 1 / 1;
		border-radius: 50%;
	}

	.card--highlight .card__text {
		flex: 1 1 auto;
		gap: var(--space-1);
	}

	.card--highlight .card__kicker {
		color: var(--highlights-card-kicker-text);
	}

	.card--highlight .card__headline {
		font-size: var(--size-headline-17);
		color: var(--highlights-card-headline);
	}

	@media (min-width: 740px) {
		.card--highlight .card__media {
			width: 100px;
		}
		.card--highlight .card__headline {
			font-size: var(--size-headline-20);
		}
	}
</style>
