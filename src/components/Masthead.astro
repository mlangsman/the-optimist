---
/**
 * Masthead — modelled on the Guardian's `<header data-component="header">`,
 * in the same order the Guardian's own DOM has it:
 *
 *   1. a thin dark top bar (edition date, utility links)
 *   2. the highlights strip
 *   3. the brand band: pillar nav bottom-left, stacked wordmark top-right
 *   4. a sub-navigation row of section links
 *
 * There is no expanding menu, so nothing here needs JS except the strip's
 * optional scroll arrows (see Highlights.astro).
 */
import Highlights from './Highlights.astro';
import { PILLAR_NAV, SITE_NAME, formatDate } from '../lib/constants';
import { STRIP_CONTAINER_ID, SUBNAV_IDS, loadSiteData } from '../lib/data';
import { frontAnchor, withBase } from '../lib/url';

interface Props {
	/** The pillar to mark as current in the nav. */
	pillar?: string;
}

const { pillar = 'news' } = Astro.props;

const site = loadSiteData();
const today = formatDate(site.date);
const homeHref = withBase('/');

const containers = new Map(site.front.map((container) => [container.id, container]));
const highlights = containers.get(STRIP_CONTAINER_ID);

// All five pillars always appear, but only anchor to a container the current
// edition actually rendered — otherwise the link would scroll nowhere.
const navItems = PILLAR_NAV.map((item) => ({
	...item,
	href: containers.has(item.id) ? frontAnchor(item.id) : homeHref,
	current: item.id === pillar,
}));

const subnav = SUBNAV_IDS.filter((id) => containers.has(id)).map((id) => ({
	id,
	label: containers.get(id)!.title,
	href: frontAnchor(id),
}));
---

<header class="masthead" data-component="header">
	<div class="topbar">
		<div class="gutter topbar__inner">
			<p class="topbar__date">{today}</p>
			<ul class="topbar__links">
				<li><a class="topbar__link" href={withBase('/about')}>About {SITE_NAME}</a></li>
				<li>
					<a class="topbar__link" href="https://www.theguardian.com/uk" rel="noopener noreferrer">Today's Guardian</a>
				</li>
				<li class="topbar__tag">AI-rewritten &middot; facts unchanged</li>
			</ul>
		</div>
	</div>

	{highlights && <Highlights container={highlights} />}

	<div class="brandbar">
		<div class="gutter brandbar__inner">
			<a class="wordmark" href={homeHref} aria-label={`${SITE_NAME} – back to home`}>
				<span class="wordmark__line">The</span>
				<span class="wordmark__line">Optimist</span>
			</a>

			<nav class="pillars" aria-label="Sections">
				<ul class="pillars__list">
					{
						navItems.map((item) => (
							<li class="pillars__item" data-pillar={item.id}>
								<a class="pillars__link" href={item.href} aria-current={item.current ? 'page' : undefined}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>

	{
		subnav.length > 0 && (
			<nav class="subnav" aria-label="More sections">
				<div class="gutter">
					<ul class="subnav__list">
						{subnav.map((item) => (
							<li class="subnav__item">
								<a class="subnav__link" href={item.href}>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			</nav>
		)
	}
</header>

<style>
	.masthead {
		background: var(--masthead-nav-background);
		color: var(--masthead-text);
		font-family: var(--font-sans);
	}

	/* --- thin top strip ------------------------------------------------- */
	.topbar {
		background: var(--masthead-top-bar-background);
	}

	.topbar__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 32px;
	}

	.topbar__date {
		font-size: var(--size-sans-12);
		line-height: 1;
		color: var(--brand-800);
		white-space: nowrap;
	}

	.topbar__links {
		list-style: none;
		display: flex;
		align-items: stretch;
		margin-left: auto;
	}

	.topbar__links > li {
		display: flex;
		align-items: center;
		padding: 0 var(--space-3);
		border-left: 1px solid var(--masthead-nav-border);
		font-size: var(--size-sans-14);
		font-weight: 700;
		line-height: 32px;
	}

	.topbar__links > li:last-child {
		padding-right: 0;
	}

	.topbar__link {
		color: var(--masthead-text);
		text-decoration: none;
	}

	.topbar__link:hover,
	.topbar__link:focus-visible {
		text-decoration: underline;
	}

	.topbar__links > .topbar__tag {
		color: var(--brand-800);
		font-weight: 400;
	}

	/* Below tablet the strip keeps the date and the About link only, as the
	   Guardian's mobile top bar keeps just "Sign in". */
	@media (max-width: 739px) {
		.topbar__links > li:not(:first-child) {
			display: none;
		}
		.topbar__links > li {
			white-space: nowrap;
		}
	}

	/* --- brand band ----------------------------------------------------- */
	.brandbar__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			'. wordmark'
			'pillars pillars';
		column-gap: var(--space-4);
	}

	/* --- wordmark ------------------------------------------------------- */
	/* Two right-aligned lines in the headline face, as the Guardian's logo
	   is set: tight leading, slight negative tracking, no italic. */
	.wordmark {
		grid-area: wordmark;
		justify-self: end;
		display: flex;
		flex-direction: column;
		/* As in the Guardian's wordmark, 'The' sits over the start of the name,
		   left-aligned and slightly inset, while the block stays on the right. */
		align-items: flex-start;
		text-decoration: none;
		color: var(--masthead-text);
		padding: var(--space-3) 0 var(--space-2);
	}

	.wordmark__line {
		display: block;
		font-family: var(--font-headline);
		font-optical-sizing: auto;
		font-weight: 800;
		font-size: 2.5rem; /* 40px */
		line-height: 0.82;
		letter-spacing: -0.03em;
	}
	.wordmark__line:first-child {
		padding-left: 0.08em;
	}

	@media (min-width: 740px) {
		.wordmark {
			padding-top: var(--space-4);
		}
		.wordmark__line {
			font-size: 3.5rem; /* 56px */
		}
	}

	@media (min-width: 980px) {
		.brandbar__inner {
			grid-template-areas:
				'. wordmark'
				'pillars wordmark';
			align-items: end;
		}
		.wordmark {
			grid-row: 1 / 3;
			padding: var(--space-4) 0 var(--space-3);
		}
		.wordmark__line {
			font-size: 4rem; /* 64px */
		}
	}

	@media (min-width: 1140px) {
		.wordmark__line {
			font-size: 4.5rem; /* 72px */
		}
	}

	/* --- pillar nav ----------------------------------------------------- */
	.pillars {
		grid-area: pillars;
		align-self: end;
		/* Pull the nav out to the gutter edge so the first pillar's bar can sit
		   flush with the column, as on the reference. */
		margin: 0 calc(-1 * var(--page-padding));
	}

	@media (min-width: 740px) {
		.pillars {
			margin: 0;
		}
	}

	.pillars__list {
		display: flex;
		list-style: none;
		/* Horizontal scroll is confined to the nav strip so the page itself
		   never scrolls sideways at 375px. */
		overflow-x: auto;
		scrollbar-width: none;
		padding: 0 var(--page-padding);
	}

	@media (min-width: 740px) {
		.pillars__list {
			padding: 0;
		}
	}

	.pillars__list::-webkit-scrollbar {
		display: none;
	}

	.pillars__item {
		position: relative;
		flex: 0 0 auto;
	}

	/* 1px separators between pillars, as in the reference nav. */
	.pillars__item + .pillars__item::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		border-left: 1px solid var(--masthead-nav-border);
	}

	.pillars__link {
		position: relative;
		display: flex;
		align-items: flex-start;
		height: 42px;
		padding: var(--space-1) var(--space-2) 0;
		color: var(--masthead-text);
		font-family: var(--font-headline);
		font-optical-sizing: auto;
		font-size: var(--size-headline-20);
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	/* The pillar bar sits on the bottom edge of the item: shown for the
	   current pillar, and slid into view on hover/focus for the others. */
	.pillars__link::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 4px;
		background: var(--pillar-underline, var(--underline-news));
		transform: translateY(4px);
		transition: transform 0.15s ease-out;
	}

	.pillars__link[aria-current='page']::before,
	.pillars__link:hover::before,
	.pillars__link:focus-visible::before {
		transform: translateY(0);
	}

	.pillars__item:first-child .pillars__link {
		padding-left: 0;
	}

	.pillars__item:first-child .pillars__link::before {
		left: 0;
	}

	@media (min-width: 740px) {
		.pillars__link {
			height: 48px;
			padding: var(--space-2) var(--space-6) 0 var(--space-3);
			font-size: var(--size-headline-24);
		}
		.pillars__link::before {
			height: 5px;
			transform: translateY(5px);
		}
	}

	/* From desktop each pillar is a wide block with the label at its left,
	   the way the reference nav spaces them. */
	@media (min-width: 980px) {
		.pillars__link {
			height: 56px;
			min-width: 140px;
			padding: var(--space-2) var(--space-10) 0 var(--space-3);
		}
	}

	@media (min-width: 1300px) {
		.pillars__link {
			min-width: 160px;
		}
	}

	/* --- sub-navigation ------------------------------------------------- */
	.subnav {
		background: var(--masthead-nav-background);
		border-top: 1px solid var(--masthead-nav-border);
	}

	.subnav__list {
		list-style: none;
		display: flex;
		gap: var(--space-4);
		overflow-x: auto;
		scrollbar-width: none;
		min-height: 36px;
		align-items: center;
	}

	.subnav__list::-webkit-scrollbar {
		display: none;
	}

	.subnav__item {
		flex: 0 0 auto;
	}

	.subnav__link {
		color: var(--masthead-text);
		font-size: var(--size-sans-15);
		font-weight: 400;
		line-height: 36px;
		text-decoration: none;
		white-space: nowrap;
	}

	.subnav__link:hover,
	.subnav__link:focus-visible {
		text-decoration: underline;
	}

	@media (min-width: 740px) {
		.subnav__list {
			min-height: 40px;
			gap: var(--space-5);
		}
		.subnav__link {
			font-size: var(--size-sans-17);
			line-height: 40px;
		}
	}
</style>
