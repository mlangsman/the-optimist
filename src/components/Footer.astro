---
import { DISCLAIMER, PILLAR_NAV, REPO_URL, SITE_NAME, formatDate } from '../lib/constants';
import { loadSiteData } from '../lib/data';
import { frontAnchor, withBase } from '../lib/url';

const site = loadSiteData();
---

<footer class="footer">
	<div class="gutter footer__inner">
		<nav class="footer__nav" aria-label="Footer">
			<ul class="footer__list">
				<li><a class="footer__link" href={withBase('/')}>Front page</a></li>
				<li><a class="footer__link" href={withBase('/about')}>About</a></li>
				<li>
					<a class="footer__link" href={REPO_URL} rel="noopener noreferrer" target="_blank">
						Source repository
					</a>
				</li>
			</ul>
			<ul class="footer__list footer__list--sections">
				{
					PILLAR_NAV.map((item) => (
						<li>
							<a class="footer__link" href={frontAnchor(item.id)}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<p class="footer__disclaimer">{DISCLAIMER}</p>

		<p class="footer__meta">
			<span>{SITE_NAME}</span>
			<span aria-hidden="true">&middot;</span>
			<span>Edition of {formatDate(site.date)}</span>
		</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--footer-background);
		color: var(--footer-text);
		font-family: var(--font-sans);
		border-top: 1px solid var(--footer-border);
	}

	.footer__inner {
		padding-top: var(--space-6);
		padding-bottom: var(--space-10);
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.footer__nav {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.footer__list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
	}

	.footer__link {
		color: var(--footer-link);
		font-size: var(--size-sans-15);
		font-weight: 700;
		line-height: var(--leading-sans);
		text-decoration: none;
	}

	.footer__link:hover,
	.footer__link:focus-visible {
		text-decoration: underline;
	}

	.footer__list--sections .footer__link {
		font-weight: 400;
		color: var(--brand-800);
	}

	.footer__disclaimer {
		max-width: var(--measure);
		font-size: var(--size-sans-15);
		line-height: var(--leading-sans);
		padding-top: var(--space-4);
		border-top: 1px solid var(--footer-border);
	}

	.footer__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		font-size: var(--size-sans-12);
		color: var(--brand-800);
	}

	@media (min-width: 740px) {
		.footer__nav {
			flex-direction: row;
			justify-content: space-between;
			gap: var(--space-8);
		}
	}
</style>
